# ---------------------------------------------------------------------------
# Kinoteka configuration. Copy to .env and fill in.
# ---------------------------------------------------------------------------

# --- Metadata -------------------------------------------------------------
# Free key from https://www.themoviedb.org/settings/api
# Either the v3 API key or the v4 read access token works.
TMDB_API_KEY=

# Interface / metadata language. TMDB has full Russian localisation.
DEFAULT_LANGUAGE=ru-RU
FALLBACK_LANGUAGE=en-US

# Country used for release dates, age ratings and "where to watch legally".
DEFAULT_REGION=RU

# --- Server ---------------------------------------------------------------
PORT=8080
HOST=0.0.0.0

# Where the JSON store, cache and download index live.
DATA_DIR=./data

# Secret used to sign session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=

# Access code required to enter the site. Leave empty to make the site open.
# This is what you give to friends.
ACCESS_CODE=

# --- Your media library ---------------------------------------------------
# Comma-separated list of folders holding video files you own.
# Example: MEDIA_ROOTS=/mnt/movies,/mnt/series
#
# Remote storage works the same way — mount it first, then point here:
#   NAS over SMB:    mount -t cifs //nas/movies /mnt/movies -o user=...
#   NAS over NFS:    mount -t nfs nas:/movies /mnt/movies
#   WebDAV / cloud:  rclone mount mydrive:Movies /mnt/movies --vfs-cache-mode full
MEDIA_ROOTS=

# Rescan the library automatically every N minutes (0 disables).
LIBRARY_SCAN_INTERVAL=60

# Path to ffprobe. Optional — enables audio-track / subtitle detection.
FFPROBE_PATH=ffprobe
